---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	/** Imagen para redes sociales; por defecto, la genérica del sitio */
	image?: string;
}

const { title, description, image = '/og.png' } = Astro.props;

// Las URL absolutas requieren `site` en astro.config.mjs
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site);
const ogImage = Astro.site && new URL(image, Astro.site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-jakarta" preload={[{ weight: 800 }, { weight: 400 }]} />
		<Font cssVariable="--font-jetbrains" />

		<title>{title}</title>
		<meta name="description" content={description} />
		{canonical && <link rel="canonical" href={canonical} />}

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		{ogImage && <meta property="og:image" content={ogImage} />}

		<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}
	</head>
	<body class="min-h-dvh">
		<a
			href="#contenido"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-20 focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
		>
			Saltar al contenido
		</a>
		<slot />
	</body>
</html>
