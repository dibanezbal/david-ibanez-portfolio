---
import Logo from './Logo.astro';
import { getAlternatePath, getLang, routes, ui } from '../i18n/ui';

interface Props {
	/** Página equivalente en el otro idioma, si no se deduce de la URL (la 404) */
	alternate?: string;
}

const lang = getLang(Astro.currentLocale);
const t = ui[lang];
const route = routes[lang];
const otherLang = lang === 'en' ? 'es' : 'en';
const { alternate = getAlternatePath(Astro.url.pathname) } = Astro.props;
const nav = [
	{ label: t.navProjects, href: `${route.home}#${route.anchors.projects}` },
	{ label: t.navExperience, href: `${route.home}#${route.anchors.experience}` },
	{ label: t.navContact, href: `#${route.anchors.contact}`, contact: true },
	{ label: 'CV', href: t.cvFile, download: true },
];
---

<header class="sticky top-0 z-40 bg-paper" data-header>
	<div class="shell relative grid grid-cols-[1fr_auto] items-center gap-x-6 py-6 md:grid-cols-[1fr_auto_1fr]">
	<Logo />

	<nav id="menu-principal" aria-label={t.navLabel} class="absolute inset-x-0 top-full z-50 hidden border-b border-ink bg-paper px-5 md:static md:col-span-1 md:block md:justify-self-center md:border-0 md:bg-transparent md:px-0">
		<ul class="flex flex-col gap-1 py-4 text-base font-medium md:flex-row md:gap-x-6 md:py-0 md:text-sm">
			{
				nav.map((item) => (
					<li>
						<a
							href={item.href}
							download={item.download}
							aria-label={item.download ? t.cvDownloadLabel : undefined}
								data-contacto={item.contact ? '' : undefined}
							class="inline-block py-1 underline-offset-4 transition-colors hover:text-accent-text hover:underline aria-[current=true]:text-accent-text aria-[current=true]:underline"
						>
							{item.label}
							{item.download && <span aria-hidden="true"> ↓</span>}
						</a>
					</li>
				))
			}
		</ul>
	</nav>

	<div class="flex items-center justify-end gap-1 md:justify-self-end">
		<!-- Selector de idioma: enlaza a esta misma página en el otro idioma y recuerda la elección -->
		<a
			href={alternate}
			hreflang={otherLang}
			lang={otherLang}
			aria-label={t.langLabel}
			data-idioma={otherLang}
			class="flex h-9 items-center gap-1.5 px-2 text-sm font-medium transition-colors hover:text-accent-text"
		>
			<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
				<circle cx="12" cy="12" r="9" />
				<path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9s1.3-6.4 3.8-9z" />
			</svg>
			{t.langShort}
		</a>
		<button
			type="button"
			id="cambiar-tema"
			data-label-dark={t.themeDark}
			data-label-light={t.themeLight}
			aria-label={t.themeDark}
			class="grid size-9 cursor-pointer place-items-center transition-colors hover:text-accent-text"
		>
			<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-icono="luna">
				<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
			</svg>
			<svg class="size-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true" data-icono="sol">
				<circle cx="12" cy="12" r="4" />
				<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
			</svg>
		</button>
		<button
			type="button"
			id="abrir-menu"
			aria-controls="menu-principal"
			aria-expanded="false"
			class="grid size-9 cursor-pointer place-items-center transition-colors hover:text-accent-text md:hidden"
		>
			<span class="sr-only">{t.menu}</span>
			<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
				<path d="M4 7h16M4 12h16M4 17h16" />
			</svg>
		</button>
	</div>
	</div>
</header>

<script>
	// Cambia entre modo claro y oscuro y recuerda la elección
	const themeButton = document.getElementById('cambiar-tema');
	const isDark = () =>
		document.documentElement.dataset.theme === 'dark' ||
		(document.documentElement.dataset.theme !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
	const renderTheme = () => {
		if (!themeButton) return;
		const dark = isDark();
		themeButton.setAttribute('aria-label', (dark ? themeButton.dataset.labelLight : themeButton.dataset.labelDark) ?? '');
		themeButton.querySelector('[data-icono="luna"]')?.classList.toggle('hidden', dark);
		themeButton.querySelector('[data-icono="sol"]')?.classList.toggle('hidden', !dark);
	};
	themeButton?.addEventListener('click', () => {
		const next = isDark() ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		try {
			localStorage.setItem('tema', next);
		} catch {}
		renderTheme();
	});
	renderTheme();

	// Al elegir idioma a mano, esa elección manda sobre el idioma del navegador
	document.querySelector<HTMLElement>('[data-idioma]')?.addEventListener('click', (event) => {
		try {
			localStorage.setItem('idioma', (event.currentTarget as HTMLElement).dataset.idioma ?? '');
		} catch {}
	});

	// Menú desplegable en móvil: se cierra con Escape, al elegir un apartado, al tocar fuera o al volver a pulsar
	const menu = document.getElementById('menu-principal');
	const menuButton = document.getElementById('abrir-menu');
	const setMenu = (open: boolean) => {
		menu?.classList.toggle('hidden', !open);
		menuButton?.setAttribute('aria-expanded', String(open));
	};
	menuButton?.addEventListener('click', () => setMenu(menu?.classList.contains('hidden') ?? false));
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
			setMenu(false);
			menuButton.focus();
		}
	});
	document.addEventListener('click', (event) => {
		const target = event.target as Node;
		if (menu?.classList.contains('hidden') || menu?.contains(target) || menuButton?.contains(target)) return;
		setMenu(false);
	});
	menu?.addEventListener('click', (event) => {
		if ((event.target as HTMLElement).closest('a')) setMenu(false);
	});

	// Marca en la cabecera el apartado que se está leyendo
	const links = [...document.querySelectorAll<HTMLAnchorElement>('header nav a')];
	const targets = links
		.map((link) => document.getElementById(link.hash.slice(1)))
		.filter((element): element is HTMLElement => element !== null);

	// Cuenta el último apartado cuyo título ha pasado del 30 % superior. Al final de la página, el pie (contacto)
	// queda marcado aunque no llegue a esa franja, y por encima del primer apartado no se marca ninguno
	const marcarApartado = () => {
		const linea = window.innerHeight * 0.3;
		const alFinal = window.scrollY > 0 && window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
		const actual = targets.filter((target) => target.getBoundingClientRect().top <= linea).at(-1);
		const activo = alFinal
			? links.find((link) => link.hasAttribute('data-contacto'))
			: links.find((link) => link.hash === `#${actual?.id}`);
		links.forEach((link) => link.toggleAttribute('aria-current', false));
		activo?.setAttribute('aria-current', 'true');
	};
	window.addEventListener('scroll', marcarApartado, { passive: true });
	marcarApartado();

	// Al desplazarse, la cabecera se compacta para ocupar menos pantalla (sobre todo en móvil)
	const cabecera = document.querySelector('[data-header]');
	const compactar = () => cabecera?.toggleAttribute('data-compact', window.scrollY > 48);
	window.addEventListener('scroll', compactar, { passive: true });
	compactar();
</script>
