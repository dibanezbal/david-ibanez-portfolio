---
import { Image } from 'astro:assets';
import Mockup from './Mockup.astro';
import { formatPeriod } from '../lib/format';
import { getLang, routes, ui } from '../i18n/ui';
import type { ProjectEntry } from '../lib/projects';

interface Props {
	project: ProjectEntry;
	/** Imagen a la derecha en escritorio, para alternar el ritmo de la lista */
	reverse?: boolean;
}

const { project, reverse = false } = Astro.props;
const { id, data } = project;
const lang = getLang(Astro.currentLocale);
const t = ui[lang];
const caseUrl = routes[lang].project(id);
// El resto de enlaces se muestran en el caso de estudio
const mainLink = data.links[0];
const disciplines = data.disciplines.map((discipline) => t.disciplines[discipline]).join(', ');
---

<!-- El texto va antes que la captura; en escritorio se colocan lado a lado y alternan -->
<article class="reveal group relative grid gap-8 border-t border-ink py-10 lg:grid-cols-12 lg:gap-12 lg:py-16">
	<div class="lg:col-span-4">
		<h3 class="text-3xl font-semibold leading-tight tracking-tight md:text-4xl">
			<a href={caseUrl} class="underline-offset-4 after:absolute after:inset-0 group-hover:underline">
				{data.title}
			</a>
		</h3>

		<p class="mt-5 text-xl leading-snug">{data.hook}</p>

		<p class="mt-5 text-sm leading-relaxed text-muted">
			{disciplines} · {t.contexts[data.context]} · {formatPeriod(data, lang)}
			{data.recognition && <span class="block">{data.recognition}</span>}
		</p>

		<ul class="relative z-10 mt-6 flex flex-wrap gap-x-6 gap-y-2 font-medium">
			<li>
				<a
					href={caseUrl}
					class="inline-flex min-h-11 items-center gap-1 text-accent-text underline underline-offset-4 transition-colors hover:text-ink"
				>
					{t.seeCase}<span class="sr-only">: {data.title}</span>
					<span aria-hidden="true">→</span>
				</a>
			</li>
			{
				mainLink && (
					<li>
						<a
							href={mainLink.url}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex min-h-11 items-center gap-1 underline underline-offset-4 transition-colors hover:text-accent-text"
						>
							{mainLink.label}
							<span aria-hidden="true">↗</span>
						</a>
					</li>
				)
			}
		</ul>
	</div>

	<div class:list={['lg:col-span-8', !reverse && 'lg:order-first']}>
		{
			data.cover && (
				<div class="transition-transform duration-500 ease-out motion-safe:group-hover:scale-[1.01]">
					<Mockup desktop={data.cover} mobile={data.mobile} />
				</div>
			)
		}
	</div>
</article>
