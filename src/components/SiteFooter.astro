---
import { getEntry } from 'astro:content';

const home = await getEntry('site', 'home');
if (!home) throw new Error('Falta src/content/site/home.md');
const { contact } = home.data;
---

<footer class="bg-footer text-footer-text">
	<div class="shell py-16 md:py-24">
		<h2 id="contacto" class="sr-only">Contacto</h2>
		<p class="mt-6 max-w-[24ch] text-3xl font-semibold leading-tight tracking-tight md:text-5xl">
			{contact.intro}
		</p>
		<a
			href={`mailto:${contact.email}`}
			class="mt-10 inline-block break-all text-xl font-medium text-footer-text underline underline-offset-8 transition-colors hover:opacity-70 md:text-3xl"
		>
			{contact.email}
		</a>
		<ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 font-medium">
			<li>
				<a href={contact.linkedin} target="_blank" rel="noopener noreferrer" class="inline-block py-1 underline underline-offset-4 transition-colors hover:opacity-70">
					LinkedIn <span aria-hidden="true">↗</span>
				</a>
			</li>
			<li>
				<a href={contact.github} target="_blank" rel="noopener noreferrer" class="inline-block py-1 underline underline-offset-4 transition-colors hover:opacity-70">
					GitHub <span aria-hidden="true">↗</span>
				</a>
			</li>
			<li>
				<a href="/cv/David-Ibanez-CV-ES.pdf" download class="inline-block py-1 underline underline-offset-4 transition-colors hover:opacity-70">
					Descargar CV
				</a>
			</li>
		</ul>
		<p class="mt-16 text-sm text-muted-on-ink">David Ibáñez · Barcelona</p>
	</div>
</footer>
