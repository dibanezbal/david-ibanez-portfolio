---
import { getEntry } from 'astro:content';

const home = await getEntry('site', 'home');
if (!home) throw new Error('Falta src/content/site/home.md');
const { contact } = home.data;
---

<footer class="bg-ink text-paper">
	<div class="shell py-16 md:py-24">
		<h2 id="contacto" class="scroll-mt-8 text-sm text-muted-on-ink">Contacto</h2>
		<p class="mt-6 max-w-[24ch] text-3xl font-semibold leading-tight tracking-tight md:text-5xl">
			{contact.intro}
		</p>
		<a
			href={`mailto:${contact.email}`}
			class="mt-10 inline-block break-all text-xl font-medium text-paper underline underline-offset-8 transition-colors hover:text-muted-on-ink md:text-3xl"
		>
			{contact.email}
		</a>
		<button
			type="button"
			data-copy-email={contact.email}
			class="mt-4 inline-block border border-paper px-4 py-2 text-sm font-medium transition-colors hover:bg-paper hover:text-ink"
		>
			Copiar correo
		</button>
		<span role="status" class="ml-3 text-sm text-muted-on-ink" data-copy-status></span>
		<ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 font-medium">
			<li>
				<a href={contact.linkedin} target="_blank" rel="noopener noreferrer" class="inline-block py-1 underline underline-offset-4 transition-colors hover:text-muted-on-ink">
					LinkedIn <span aria-hidden="true">↗</span>
				</a>
			</li>
			<li>
				<a href={contact.github} target="_blank" rel="noopener noreferrer" class="inline-block py-1 underline underline-offset-4 transition-colors hover:text-muted-on-ink">
					GitHub <span aria-hidden="true">↗</span>
				</a>
			</li>
		</ul>
		<p class="mt-16 text-sm text-muted-on-ink">David Ibáñez · Barcelona</p>
	</div>
</footer>

<script>
	// Copia el correo al portapapeles y confirma la acción sin mover el foco
	const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
	const status = document.querySelector<HTMLElement>('[data-copy-status]');

	button?.addEventListener('click', async () => {
		try {
			await navigator.clipboard.writeText(button.dataset.copyEmail ?? '');
			if (status) status.textContent = 'Correo copiado';
		} catch {
			if (status) status.textContent = 'No se pudo copiar; selecciona el correo';
		}
	});
</script>
