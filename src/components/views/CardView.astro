---
import { Image } from 'astro:assets';
import { getLang, ui } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import QRCard from '../QRCard.astro';
import davidFront from '../../assets/img/david-ibanez-front.jpg';

const lang = getLang(Astro.currentLocale);
const t = ui[lang];
const cardUrl = `https://davidib.com${lang === 'en' ? '/en' : ''}/card`;

const contact = {
	name: 'David Ibáñez',
	title: 'Design & Development',
	email: 'dibanezbal@gmail.com',
	linkedin: 'https://www.linkedin.com/in/davidib',
	github: 'https://github.com/dibanezbal',
	website: 'davidib.com'
};

const cvFiles = {
	es: '/cv/David-Ibanez-CV-ES.pdf',
	en: '/cv/David-Ibanez-CV-EN.pdf'
};

const labels = {
	es: {
		title: 'Tarjeta Digital',
		description: 'Tarjeta de visita digital de David Ibáñez, Design Engineer en Barcelona',
		title2: 'David Ibáñez',
		downloadCV: 'Descargar CV',
		language: 'Idioma:',
		or: 'o',
		scanQR: 'Escanea este código QR',
		shareInfo: 'Comparte esta tarjeta'
	},
	en: {
		title: 'Digital Card',
		description: 'Digital business card of David Ibáñez, Design Engineer in Barcelona',
		title2: 'David Ibáñez',
		downloadCV: 'Download CV',
		language: 'Language:',
		or: 'or',
		scanQR: 'Scan this QR code',
		shareInfo: 'Share this card'
	}
};

const label = labels[lang];

// Iconos de línea en un solo trazo; el texto del enlace siempre es visible
const icons = {
	mail: '<rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 7 9 6 9-6"/>',
	link: '<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3A4 4 0 0 0 11 18.7l1-1"/>',
	code: '<path d="m8 8-4 4 4 4"/><path d="m16 8 4 4-4 4"/><path d="m13.5 6-3 12"/>',
};
const links = [
	{ label: contact.email, href: `mailto:${contact.email}`, icon: icons.mail, external: false },
	{ label: 'LinkedIn', href: contact.linkedin, icon: icons.link, external: true },
	{ label: 'GitHub', href: contact.github, icon: icons.code, external: true },
];
---

<Layout title={`${label.title} · David Ibáñez`} description={label.description}>
	<SiteHeader />

	<main id="contenido" class="shell py-10 md:py-16">
		<div class="mx-auto max-w-md">
			<header class="flex items-center gap-5 border-b border-ink pb-8">
				<Image src={davidFront} alt="" width={160} class="size-20 shrink-0 border border-line object-cover object-top" />
				<div>
					<h1 class="text-3xl font-semibold leading-tight tracking-[-0.02em]">{contact.name}</h1>
					<p class="mt-1 text-muted">{contact.title}</p>
					<p class="mt-0.5 text-sm text-muted">{contact.website}</p>
				</div>
			</header>

			<ul class="border-b border-ink">
				{
					links.map((item) => (
						<li class="border-t border-line first:border-t-0">
							<a
								href={item.href}
								{...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
								class="group flex min-h-14 items-center gap-4 transition-colors hover:text-accent-text"
							>
								<svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
								<span class="font-medium underline-offset-4 group-hover:underline">{item.label}</span>
								{item.external && <span class="ml-auto" aria-hidden="true">↗</span>}
							</a>
						</li>
					))
				}
			</ul>

			<div class="mt-8">
				<p class="text-sm font-medium text-muted">{label.language}</p>
				<div class="mt-3 flex flex-col gap-3 sm:flex-row">
					<a
						href={cvFiles.es}
						download
						class="inline-flex min-h-11 flex-1 items-center justify-center border border-accent bg-accent px-5 font-medium text-paper transition-colors hover:border-ink hover:bg-ink focus-visible:outline-ink"
					>
						{label.downloadCV} ES
					</a>
					<a
						href={cvFiles.en}
						download
						class="inline-flex min-h-11 flex-1 items-center justify-center border border-ink px-5 font-medium transition-colors hover:bg-ink hover:text-paper"
					>
						{label.downloadCV} EN
					</a>
				</div>
			</div>

			<section class="mt-12 border-t border-ink pt-8" aria-labelledby="qr-titulo">
				<h2 id="qr-titulo" class="text-lg font-semibold">{label.scanQR}</h2>
				<div class="mt-5">
					<QRCard url={cardUrl} size={240} />
				</div>
				<p class="mt-4 text-sm text-muted">{label.shareInfo}</p>
			</section>
		</div>
	</main>

	<SiteFooter />
</Layout>
