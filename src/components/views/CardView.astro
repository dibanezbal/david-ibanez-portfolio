---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { getAlternatePath, getLang } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import Logo from '../Logo.astro';
import QRCard from '../QRCard.astro';
import davidFront from '../../assets/img/david-ibanez-front.jpg';

const lang = getLang(Astro.currentLocale);
const en = lang === 'en';
const home = await getEntry('site', en ? 'home-en' : 'home');
if (!home) throw new Error('Falta el contenido de la portada');

const cardUrl = `https://davidib.com${en ? '/en' : ''}/card`;
const contact = {
	email: 'dibanezbal@gmail.com',
	linkedin: 'https://www.linkedin.com/in/davidib',
	github: 'https://github.com/dibanezbal',
	site: 'https://davidib.com',
};
const cv = en ? '/cv/David-Ibanez-CV-EN.pdf' : '/cv/David-Ibanez-CV-ES.pdf';

const label = en
	? {
			title: 'Digital card',
			description: 'Digital business card of David Ibáñez, Design Engineer in Barcelona.',
			role: 'Design Engineer',
			city: 'Barcelona',
			save: 'Save contact',
			saveHint: 'Adds David to your address book',
			cv: 'Download PDF',
			terms: { email: 'Email', linkedin: 'LinkedIn', github: 'GitHub', web: 'Web', cv: 'CV' },
			scan: 'Scan to open this card',
			qr: `QR code that opens ${cardUrl}`,
			switchTo: 'ES',
			switchLabel: 'ES, Spanish version',
			alt: 'Black-and-white portrait of David Ibáñez, wearing a cap and glasses, smiling.',
			newTab: ' (opens in a new tab)',
		}
	: {
			title: 'Tarjeta digital',
			description: 'Tarjeta de visita digital de David Ibáñez, Design Engineer en Barcelona.',
			role: 'Design Engineer',
			city: 'Barcelona',
			save: 'Guardar contacto',
			saveHint: 'Añade a David a tu agenda',
			cv: 'Descargar PDF',
			terms: { email: 'Correo', linkedin: 'LinkedIn', github: 'GitHub', web: 'Web', cv: 'CV' },
			scan: 'Escanea para abrir esta tarjeta',
			qr: `Código QR que abre ${cardUrl}`,
			switchTo: 'EN',
			switchLabel: 'EN, versión en inglés',
			alt: 'Retrato en blanco y negro de David Ibáñez, con gorra y gafas, sonriendo.',
			newTab: ' (se abre en una pestaña nueva)',
		};

const rows = [
	{ term: label.terms.email, text: contact.email, href: `mailto:${contact.email}`, external: false },
	{ term: label.terms.linkedin, text: 'in/davidib', href: contact.linkedin, external: true },
	{ term: label.terms.github, text: 'dibanezbal', href: contact.github, external: true },
	{ term: label.terms.web, text: 'davidib.com', href: `${contact.site}${en ? '/en' : ''}/`, external: false },
	{ term: label.terms.cv, text: label.cv, href: cv, external: false, download: true },
];
---

<Layout title={`${label.title} · David Ibáñez`} description={label.description} autoLanguage={false}>
	<main id="contenido" class="mx-auto min-h-dvh max-w-md bg-paper md:my-10 md:min-h-0 md:border md:border-ink">
		<header class="flex items-center justify-between px-5 pt-4">
			<Logo size={44} />
			<a
				href={getAlternatePath(Astro.url.pathname)}
				data-idioma={en ? 'es' : 'en'}
				hreflang={en ? 'es' : 'en'}
				lang={en ? 'es' : 'en'}
				aria-label={label.switchLabel}
				class="inline-flex size-11 items-center justify-center text-sm font-medium transition-colors hover:text-accent-text"
			>
				{label.switchTo}
			</a>
		</header>

		<h1 class="sr-only">David Ibáñez</h1>

		<div class="intro-rise mt-4 grid grid-cols-12 border-t border-ink" style="--d: 0ms">
			<div class="col-span-5 flex flex-col justify-between px-5 pb-5 pt-4">
				<div>
					<p class="text-3xl font-semibold leading-[1.05] tracking-[-0.02em]">{label.role}</p>
					<p class="mt-2 text-muted">{label.city}</p>
				</div>
				<p class="mt-8 text-sm leading-snug text-muted">{home.data.hero.headline}</p>
			</div>
			<div class="col-span-7 overflow-hidden border-l border-ink">
				<Image
					src={davidFront}
					alt={label.alt}
					width={900}
					widths={[400, 700, 900]}
					sizes="(min-width: 448px) 261px, 58vw"
					priority
					class="portrait aspect-[4/5] w-full origin-bottom scale-[1.3] object-cover object-bottom mix-blend-multiply brightness-[1.02]"
				/>
			</div>
		</div>

		<dl class="border-t border-ink px-5">
			{
				rows.map((row) => (
					<div class="grid grid-cols-[5.5rem_1fr] items-center border-b border-line last:border-b-0">
						<dt class="text-sm text-muted">{row.term}</dt>
						<dd>
							<a
								href={row.href}
								{...(row.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
								{...(row.download ? { download: true } : {})}
								class="inline-flex min-h-12 min-w-0 items-center gap-1.5 break-all font-medium underline decoration-line decoration-2 underline-offset-4 transition-colors hover:text-accent-text hover:decoration-accent"
							>
								{row.text}
								{row.external && (
									<>
										<span aria-hidden="true">↗</span>
										<span class="sr-only">{label.newTab}</span>
									</>
								)}
								{row.download && <span aria-hidden="true">↓</span>}
							</a>
						</dd>
					</div>
				))
			}
		</dl>

		<a
			href="/contacto/david-ibanez.vcf"
			download
			class="group flex min-h-[4.5rem] items-center justify-between border-t border-ink bg-ink px-5 text-paper transition-colors hover:bg-accent focus-visible:outline-offset-[-4px]"
		>
			<span>
				<span class="block text-lg font-semibold leading-tight">{label.save}</span>
				<span class="block text-sm">{label.saveHint}</span>
			</span>
			<span class="text-2xl transition-transform motion-safe:group-hover:translate-y-0.5" aria-hidden="true">↓</span>
		</a>

		<!-- Cierre en color de marca: el QR sobre una hoja blanca, como un sello -->
		<section class="flex items-center gap-5 bg-accent px-5 py-6 text-paper" aria-label={label.scan}>
			<div class="shrink-0 bg-white p-0">
				<QRCard url={cardUrl} label={label.qr} size={120} />
			</div>
			<div class="min-w-0">
				<p class="text-lg font-semibold leading-snug">{label.scan}</p>
				<p class="mt-1 break-all text-sm">davidib.com{en ? '/en' : ''}/card</p>
			</div>
		</section>
	</main>
</Layout>

<script>
	// Elegir idioma en la tarjeta se recuerda para el resto del sitio
	document.querySelector<HTMLElement>('[data-idioma]')?.addEventListener('click', (event) => {
		try {
			localStorage.setItem('idioma', (event.currentTarget as HTMLElement).dataset.idioma ?? '');
		} catch {}
	});
</script>
