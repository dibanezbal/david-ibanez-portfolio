---
import PlusIcon from '../PlusIcon.astro';
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { getLang, routes, ui } from '../../i18n/ui';
import ProjectCard from '../ProjectCard.astro';
import SectionHeading from '../SectionHeading.astro';
import SiteFooter from '../SiteFooter.astro';
import SiteHeader from '../SiteHeader.astro';
import Layout from '../../layouts/Layout.astro';
import { formatPeriod } from '../../lib/format';
import { getExperience, getPublishedProjects } from '../../lib/projects';

const lang = getLang(Astro.currentLocale);
const t = ui[lang];
const route = routes[lang];
const home = await getEntry('site', lang === 'en' ? 'home-en' : 'home');
if (!home) throw new Error('Falta el contenido de la portada');
const { hero, skills } = home.data;
const [leadSkills, ...otherSkills] = skills;
// Destaca las cifras de cada logro sin tocar el texto del CV
const figures = /(\+\d+M?|\d+\+|\d+M\b|\d+(?:,\d+)?\s?%)/;

const projects = await getPublishedProjects(lang);
const jobs = await getExperience(lang);
---

<Layout title={home.data.seo_title} description={home.data.description}>
	<SiteHeader />

	<main id="contenido">
		<section class="shell pt-6 md:pt-10">
			<div class="grid gap-10 border-b border-ink lg:grid-cols-12 lg:items-end lg:gap-8">
				<div class="lg:col-span-7 lg:pb-16">
					<h1
						class="intro-rise text-[clamp(2.25rem,4.6vw,4.5rem)] font-semibold leading-[1.04] tracking-[-0.02em]"
						style="--d: 0ms"
					>
						{hero.headline}
					</h1>
					<p class="intro-rise mt-6 max-w-2xl text-lg leading-relaxed text-muted md:mt-8 md:text-xl" style="--d: 90ms">{hero.intro}</p>
					<div class="intro-rise mt-8 flex flex-wrap items-start gap-3" style="--d: 160ms">
						<a
							href={hero.cta_primary.url}
							class="border border-accent bg-accent px-6 py-3.5 font-medium text-paper transition-colors motion-safe:transition-transform hover:border-ink hover:bg-ink focus-visible:outline-ink motion-safe:active:scale-[0.98]"
						>
							{hero.cta_primary.label}
						</a>
					</div>
					<ul class="intro-rise mt-10 grid max-w-md grid-cols-3 gap-3 md:gap-4" aria-label={t.featured} style="--d: 240ms">
						{
							projects.slice(0, 3).map((project) =>
								project.data.cover && (
									<li>
										<a href={route.project(project.id)} class="group block">
											<Image
												src={project.data.cover.src}
												alt=""
												widths={[400, 800]}
												sizes="(min-width: 1024px) 160px, 30vw"
												class="block aspect-[16/10] w-full border border-line bg-paper object-cover object-top transition-transform duration-500 ease-out motion-safe:group-hover:scale-[1.02]"
											/>
											<span class="mt-2 block text-sm font-medium underline-offset-4 group-hover:underline">{project.data.title}</span>
										</a>
									</li>
								),
							)
						}
					</ul>
				</div>
				<div class="lg:col-span-5">
					<!-- multiply funde el fondo de la foto con el papel; brightness lleva a blanco puro el fondo, que no lo es del todo. El recorte quita el aire sobrante de arriba -->
					<Image
						src={hero.portrait.src}
						alt={hero.portrait.alt}
						width={1200}
						widths={[480, 800, 1200]}
						sizes="(min-width: 1440px) 560px, (min-width: 1024px) 40vw, 100vw"
						priority
						class="intro-rise portrait aspect-[8/9] w-full object-cover object-bottom mix-blend-multiply brightness-[1.02] lg:ml-auto lg:max-w-[440px]" style="--d: 120ms"
					/>
				</div>
			</div>
		</section>

		<section class="shell pb-16 pt-16 md:pb-24 md:pt-24">
			<div class="mb-12 grid gap-6 md:mb-16 md:grid-cols-12">
				<div class="md:col-span-6"><SectionHeading id={route.anchors.projects} title={t.projects} /></div>
				<p class="text-lg leading-relaxed text-muted md:col-span-6">{home.data.projects_intro}</p>
			</div>
			{projects.map((project, index) => <ProjectCard {project} reverse={index % 2 === 1} />)}
		</section>


		<section class="shell border-t border-line py-16 md:py-24" aria-labelledby={route.anchors.bring}>
			<SectionHeading id={route.anchors.bring} title={t.bring} />
			<div class="mt-12 border-t border-ink pt-4">
				<h3 class="text-sm font-medium">{leadSkills.title}</h3>
				<ul class="mt-4 grid gap-6 text-xl leading-snug md:grid-cols-3 md:gap-8">
					{leadSkills.items.map((item) => <li>{item}</li>)}
				</ul>
			</div>
			<div class="mt-12 grid gap-10 sm:grid-cols-2 md:grid-cols-3 md:gap-8">
				{
					otherSkills.map((group) => (
						<div>
							<h3 class="border-t border-ink pt-4 text-sm font-medium">{group.title}</h3>
							<ul class="mt-4 space-y-2.5 leading-relaxed text-muted">
								{group.items.map((item) => <li>{item}</li>)}
							</ul>
						</div>
					))
				}
			</div>
		</section>

		<section class="shell border-t border-line py-16 md:py-24" aria-labelledby={route.anchors.experience}>
			<div class="grid gap-6 md:grid-cols-12">
				<div class="md:col-span-6"><SectionHeading id={route.anchors.experience} title={t.experience} /></div>
				<p class="text-lg leading-relaxed text-muted md:col-span-6">{home.data.experience_intro}</p>
			</div>
			<div class="mt-12 border-b border-ink">
				{
					jobs.map(({ data }) => (
						<details class="group border-t border-ink">
							<summary class="grid cursor-pointer list-none grid-cols-[1fr_auto] gap-x-6 gap-y-1 py-5 transition-colors hover:text-accent-text md:grid-cols-12 md:items-baseline [&::-webkit-details-marker]:hidden">
								<span class="text-sm tabular-nums text-muted md:col-span-3">{formatPeriod(data, lang)}</span>
								<span class="col-start-1 text-lg font-bold leading-snug tracking-tight md:col-span-5 md:col-start-4">
									{data.role}
								</span>
								<span class="col-start-1 leading-snug text-muted md:col-span-3 md:col-start-9">{data.company}</span>
								<PlusIcon class="col-start-2 row-start-1 mt-1.5 justify-self-end md:col-start-12 md:mt-0 md:self-center" />
							</summary>
							<div class="grid gap-4 pb-8 md:grid-cols-12 md:gap-6">
								<div class="md:col-span-8 md:col-start-4">
									<p class="text-sm leading-relaxed text-muted">
										{data.location}
										{data.via && ` · ${data.via}`}
									</p>
									{data.summary && <p class="mt-4 max-w-[70ch] leading-relaxed">{data.summary}</p>}
									<ul class="mt-4 max-w-[70ch] list-disc space-y-2.5 pl-5 leading-relaxed text-muted marker:text-accent-text">
										{
											data.highlights.map((highlight) => (
												<li>
													{highlight
														.split(figures)
														.map((part, partIndex) =>
															partIndex % 2 ? <strong class="font-semibold text-ink">{part}</strong> : part,
														)}
												</li>
											))
										}
									</ul>
									{
										data.stack.length > 0 && (
											<p class="mt-5 text-sm leading-relaxed text-muted">
												{data.stack.join(' · ')}
											</p>
										)
									}
								</div>
							</div>
						</details>
					))
				}
			</div>
			<div class="mt-20 grid gap-8 md:grid-cols-12">
				<div class="md:col-span-5"><h3 class="text-[clamp(1.625rem,3vw,2.25rem)] font-semibold leading-tight tracking-[-0.02em]">{t.about}</h3></div>
				<div
					class="max-w-prose text-xl leading-relaxed text-muted md:col-span-7 [&_em]:italic [&_p+p]:mt-5 [&_strong]:font-bold [&_strong]:text-ink"
				>
					{home.data.about_intro.map((p) => <p>{p}</p>)}
					<p class="mt-8"><a href={route.about} class="inline-block py-1 underline underline-offset-4 transition-colors hover:text-accent-text">{t.aboutMore} <span aria-hidden="true">→</span></a></p>
				</div>
			</div>
		</section>

	</main>

	<SiteFooter />
</Layout>
