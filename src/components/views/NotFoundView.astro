---
import SiteFooter from '../SiteFooter.astro';
import SiteHeader from '../SiteHeader.astro';
import Layout from '../../layouts/Layout.astro';
import { getLang, routes, ui } from '../../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = ui[lang];
const route = routes[lang];
// La 404 se sirve en cualquier dirección: su equivalente se indica aquí
const alternate = lang === 'en' ? '/404' : '/en/404';
---

<Layout title={t.notFoundTitle} description={t.notFoundDescription} {alternate}>
	<SiteHeader {alternate} />

	<main id="contenido">
		<section class="shell py-24 md:py-36">
			<p class="text-sm text-accent-text">Error 404</p>
			<h1 class="mt-5 max-w-[18ch] text-[clamp(2.5rem,5.7vw,5.75rem)] font-semibold leading-[1.02] tracking-[-0.02em]">
				{t.notFoundHeading}
			</h1>
			<p class="mt-8 max-w-2xl text-lg leading-relaxed text-muted md:text-xl">
				{t.notFoundBody}
			</p>
			<div class="mt-10 flex flex-wrap gap-3">
				<a href={route.home} class="border border-ink bg-ink px-6 py-3.5 font-medium text-paper transition-colors hover:border-accent-text hover:bg-accent-text">{t.notFoundHome}</a>
				<a href={`${route.home}#${route.anchors.projects}`} class="border border-ink px-6 py-3.5 font-medium transition-colors hover:bg-ink hover:text-paper">{t.notFoundProjects}</a>
			</div>
		</section>
	</main>

	<SiteFooter />
</Layout>
