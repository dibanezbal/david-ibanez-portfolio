---
import { getImage, Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import SiteFooter from '../SiteFooter.astro';
import SiteHeader from '../SiteHeader.astro';
import Layout from '../../layouts/Layout.astro';
import Mockup from '../Mockup.astro';
import { formatPeriod } from '../../lib/format';
import { getLang, routes, ui } from '../../i18n/ui';
import type { ProjectEntry } from '../../lib/projects';

interface Props {
	project: ProjectEntry;
	next: ProjectEntry;
}

const { project, next } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = ui[lang];
const route = routes[lang];
const { data } = project;
const { Content, headings } = await render(project);
// Índice del caso: solo los apartados principales
const sections = headings.filter((heading) => heading.depth === 2);

const socialImage = data.cover && (await getImage({ src: data.cover.src, width: 1200, format: 'jpeg' }));

const facts = [
	[t.client, data.client],
	[t.period, `${formatPeriod(data, lang)} · ${t.contexts[data.context]}`],
	[t.scope, data.disciplines.map((discipline) => t.disciplines[discipline]).join(', ')],
	...(data.recognition ? [[t.recognition, data.recognition]] : []),
];
const lists = [
	[t.myRole, data.role],
	[t.tools, data.tools],
	[t.topics, data.tags],
] as const;
---

<Layout title={`${data.title} · David Ibáñez`} description={data.summary} image={socialImage?.src}>
	<SiteHeader />

	<main id="contenido">
		<article>
			<div class="shell lg:grid lg:grid-cols-12 lg:items-start lg:gap-12">
			<header class="pb-10 pt-10 md:pb-14 md:pt-16 lg:col-span-5 lg:pb-16">
				<a
					href={`${route.home}#${route.anchors.projects}`}
					class="inline-block py-1 text-sm underline-offset-4 transition-colors hover:text-accent-text hover:underline"
				>
					<span aria-hidden="true">←</span> {t.allProjects}
				</a>
				<h1
					class="mt-10 max-w-[20ch] text-[clamp(2.25rem,3.9vw,4rem)] font-semibold leading-[1.05] tracking-[-0.02em]"
				>
					{data.title}
				</h1>
				<p class="mt-6 max-w-[30ch] text-2xl leading-snug md:text-4xl">{data.hook}</p>
				<p class="mt-6 max-w-3xl text-lg leading-relaxed text-muted md:text-xl">{data.summary}</p>
			</header>

			{
				data.cover && (
					<div class="pb-10 md:pb-14 lg:col-span-7 lg:pt-16">
						<Mockup desktop={data.cover} mobile={data.mobile} sizes="(min-width: 1440px) 1360px, 100vw" />
					</div>
				)
			}
			</div>

			{
				data.metrics.length > 0 && (
					<div class="shell mt-10 md:mt-14">
						<ul class="grid gap-8 border-y border-ink py-8 sm:grid-cols-2 lg:grid-cols-4">
							{data.metrics.map((metric) => (
								<li>
									<span class="block text-4xl font-semibold tracking-tight md:text-5xl">{metric.value}</span>
									<span class="mt-2 block text-sm leading-snug text-muted">{metric.label}</span>
								</li>
							))}
						</ul>
					</div>
				)
			}

			<div class="shell grid gap-12 py-12 md:py-20 lg:grid-cols-12 lg:gap-16">
				<aside class="self-start lg:sticky lg:top-24 lg:col-span-4" aria-label={t.factsLabel}>
					<dl class="space-y-5 text-sm leading-relaxed">
						{
							facts.map(([label, value]) => (
								<div>
									<dt class="text-sm text-muted">{label}</dt>
									<dd class="mt-1 font-medium">{value}</dd>
								</div>
							))
						}
						{
							lists.map(([label, items]) => (
								<div>
									<dt class="text-sm text-muted">{label}</dt>
									<dd class="mt-1">{items.join(' · ')}</dd>
								</div>
							))
						}
					</dl>
					{
						data.links.length > 0 && (
							<ul class="mt-8 space-y-2 border-t border-line pt-6 text-sm font-medium">
								{data.links.map((link) => (
									<li>
										<a
											href={link.url}
											target="_blank"
											rel="noopener noreferrer"
											class="inline-flex min-h-6 items-center gap-1 text-accent-text underline underline-offset-4 transition-colors hover:text-ink"
										>
											{link.label}
											<span aria-hidden="true">↗</span>
										</a>
									</li>
								))}
							</ul>
						)
					}
					{
						sections.length > 1 && (
							<nav aria-label={t.sectionsLabel} class="mt-10 hidden border-t border-line pt-6 lg:block">
								<p class="text-sm text-muted">{t.inThisCase}</p>
								<ol class="mt-3 space-y-2 text-sm">
									{sections.map((section) => (
										<li>
											<a href={`#${section.slug}`} class="inline-flex min-h-6 items-center underline-offset-4 transition-colors hover:text-accent-text hover:underline">
												{section.text}
											</a>
										</li>
									))}
								</ol>
							</nav>
						)
					}
				</aside>

				<div class="case-prose lg:col-span-8">
					<Content />
					<aside class="mt-16 border-t border-ink pt-8" aria-label={t.contactLabel}>
						<p class="text-2xl font-semibold leading-snug tracking-tight">{t.ctaQuestion}</p>
						<a
							href={`mailto:${(await getEntry('site', lang === 'en' ? 'home-en' : 'home'))?.data.contact.email}`}
							class="mt-4 inline-block font-medium text-accent-text underline underline-offset-4 transition-colors hover:text-ink"
						>
							{t.ctaEmail}
						</a>
					</aside>
				</div>
			</div>
		</article>

		{
			next.id !== project.id && (
				<nav aria-label={t.nextProject} class="shell pb-16 md:pb-24">
					<a href={route.project(next.id)} class="group block border-t border-ink pt-6">
						<span class="text-sm text-muted">{t.nextProject}</span>
						<span class="mt-3 block max-w-[24ch] text-3xl font-semibold leading-tight tracking-tight underline-offset-4 transition-colors group-hover:text-accent-text group-hover:underline md:text-5xl">
							{next.data.title} <span aria-hidden="true">→</span>
						</span>
					</a>
				</nav>
			)
		}
	</main>

	<SiteFooter />
</Layout>
