---
// Cómo hice este portfolio: caso aparte, fuera de la colección de proyectos para no mezclarlo con ellos
import { getLang, routes } from '../../i18n/ui';
import SiteFooter from '../SiteFooter.astro';
import SiteHeader from '../SiteHeader.astro';
import Layout from '../../layouts/Layout.astro';
import * as es from '../../content/making/es.md';
import * as enContent from '../../content/making/en.md';
import CaseIndex from '../CaseIndex.astro';
import FactItem from '../FactItem.astro';
import PlusIcon from '../PlusIcon.astro';
import { ui } from '../../i18n/ui';
import { getImage, Image } from 'astro:assets';
import cover from '../../assets/projects/portfolio/portada-publicada.webp';
import brandV1 from '../../assets/projects/portfolio/marca-v1.webp';
import brandFinal from '../../assets/projects/portfolio/marca-final.webp';

const lang = getLang(Astro.currentLocale);
const route = routes[lang];
const en = lang === 'en';
const t = ui[lang];
const { Content, getHeadings } = en ? enContent : es;
// Índice: solo los apartados principales
const sections = getHeadings().filter((heading) => heading.depth === 2);
// Imagen para redes: la parte de arriba de la portada publicada, como en los casos
const socialImage = await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpeg' });

const copy = en
	? {
			title: 'How I built this portfolio',
			description: 'How David Ibáñez built his portfolio with AI: visual identity, Figma wireframe, Astro, Playwright tests and deployment to GitHub Pages.',
			lead: 'The brand, the wireframe, the code, the tests and the deployment of this site: what I decided and where AI helped me.',
			back: 'Projects',
			facts: [
				['Period', 'October–November 2026 · Personal'],
				['Design and code', 'Figma · Astro · Tailwind CSS · Claude Code'],
				['Tests and publishing', 'Playwright · axe · GitHub Actions · GitHub Pages'],
				['Domain', 'davidib.com, registered with Hostinger'],
			],
			repo: 'Code on GitHub',
			closing: 'See the projects',
			brand: [
				{ label: 'First version', src: brandV1, alt: 'First version of the logo: the D with an orange brim and the name in Plus Jakarta Sans, with the role in a monospaced font, on an off-white background with rounded corners.' },
				{ label: 'Final version', src: brandFinal, alt: 'Final logo: the D with a crimson brim and the name and role in Schibsted Grotesk, on white.' },
			],
			newTab: ' (opens in a new tab)',
		}
	: {
			title: 'Cómo hice este portfolio',
			description: 'Cómo creó David Ibáñez su portfolio con IA: identidad gráfica, wireframe en Figma, Astro, tests con Playwright y despliegue en GitHub Pages.',
			lead: 'La marca, el wireframe, el código, las pruebas y el despliegue de esta web: qué decidí yo y en qué me ayudó la IA.',
			back: 'Proyectos',
			facts: [
				['Periodo', 'Octubre–noviembre de 2026 · Personal'],
				['Diseño y código', 'Figma · Astro · Tailwind CSS · Claude Code'],
				['Pruebas y publicación', 'Playwright · axe · GitHub Actions · GitHub Pages'],
				['Dominio', 'davidib.com, registrado en Hostinger'],
			],
			repo: 'Código en GitHub',
			closing: 'Ver los proyectos',
			brand: [
				{ label: 'Primera versión', src: brandV1, alt: 'Primera versión del logotipo: la D con visera naranja y el nombre en Plus Jakarta Sans, con el rol en una fuente monoespaciada, sobre fondo blanco roto con esquinas redondeadas.' },
				{ label: 'Versión final', src: brandFinal, alt: 'Logotipo final: la D con visera carmín y el nombre y el rol en Schibsted Grotesk, sobre blanco.' },
			],
			newTab: ' (se abre en una pestaña nueva)',
		};
---

<Layout title={`${copy.title} · David Ibáñez`} description={copy.description} image={socialImage.src}>
	<SiteHeader />

	<main id="contenido">
		<article>
			<div class="shell lg:grid lg:grid-cols-12 lg:items-start lg:gap-12">
				<header class="pb-10 pt-10 md:pb-14 md:pt-16 lg:col-span-5 lg:pb-16">
					<a
						href={`${route.home}#${route.anchors.projects}`}
						class="inline-flex min-h-11 items-center gap-1 text-sm underline-offset-4 transition-colors hover:text-accent-text hover:underline"
					>
						<span aria-hidden="true">←</span> {copy.back}
					</a>
					<h1 class="mt-10 max-w-[20ch] text-[clamp(2.25rem,3.9vw,4rem)] font-semibold leading-[1.05] tracking-[-0.02em]">{copy.title}</h1>
					<p class="mt-6 max-w-prose text-xl leading-relaxed text-muted">{copy.lead}</p>
				</header>

				<!-- Portada: la marca descartada junto a la final, en lugar de una captura -->
				<div class="grid grid-cols-2 gap-4 pb-10 md:gap-5 md:pb-14 lg:col-span-7 lg:pt-16">
					{
						copy.brand.map((version) => (
							<figure class="m-0">
								<figcaption class="mb-2 text-sm font-medium text-muted">{version.label}</figcaption>
								<Image src={version.src} alt={version.alt} widths={[400, 680]} sizes="(min-width: 1024px) 28vw, 45vw" class="block h-auto w-full" />
							</figure>
						))
					}
				</div>
			</div>

			<div class="shell grid gap-10 border-t border-ink pb-16 pt-10 md:pb-20 lg:grid-cols-12 lg:gap-16">
				<aside class="lg:col-span-4" aria-label={t.factsLabel}>
					<!-- Escritorio: ficha completa. Móvil: el enlace al código a la vista y la ficha plegada, como en los casos -->
					<dl class="hidden space-y-5 text-sm leading-relaxed lg:block">
						{copy.facts.map(([label, value]) => <FactItem {label} {value} />)}
					</dl>
					<p class="border-line text-sm font-medium lg:mt-8 lg:border-t lg:pt-6">
						<a
							href="https://github.com/dibanezbal/david-ibanez-portfolio"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex min-h-11 items-center gap-1 text-accent-text underline underline-offset-4 transition-colors hover:text-ink"
						>
							{copy.repo}<span aria-hidden="true">↗</span><span class="sr-only">{copy.newTab}</span>
						</a>
					</p>
					<details class="group mt-6 border-t border-ink lg:hidden">
						<summary class="flex cursor-pointer list-none items-center justify-between py-4 font-medium transition-colors hover:text-accent-text [&::-webkit-details-marker]:hidden">
							{t.factsLabel}
							<PlusIcon />
						</summary>
						<dl class="space-y-5 pb-5 text-sm leading-relaxed">
							{copy.facts.map(([label, value]) => <FactItem {label} {value} />)}
						</dl>
					</details>
					<CaseIndex {sections} />
				</aside>

				<div class="case-prose lg:col-span-8">
					<Content />
				</div>
			</div>
		</article>

		<nav aria-label={copy.closing} class="shell pb-16 md:pb-24">
			<a href={`${route.home}#${route.anchors.projects}`} class="group block border-t border-ink pt-6">
				<span class="block max-w-[24ch] text-3xl font-semibold leading-tight tracking-tight underline-offset-4 transition-colors group-hover:text-accent-text group-hover:underline md:text-5xl">
					{copy.closing} <span aria-hidden="true">→</span>
				</span>
			</a>
		</nav>
	</main>

	<SiteFooter />
</Layout>
