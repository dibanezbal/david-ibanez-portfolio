---
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Layout from '../../layouts/Layout.astro';
import { formatPeriod } from '../../lib/format';
import { contextLabels, disciplineLabels, getPublishedProjects } from '../../lib/projects';

export async function getStaticPaths() {
	const projects = await getPublishedProjects();
	return projects.map((project, index) => ({
		params: { id: project.id },
		props: { project, next: projects[(index + 1) % projects.length] },
	}));
}

const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const socialImage = data.cover && (await getImage({ src: data.cover.src, width: 1200, format: 'jpeg' }));

const facts = [
	['Cliente', data.client],
	['Periodo', formatPeriod(data)],
	['Tipo', contextLabels[data.context]],
	...(data.recognition ? [['Reconocimiento', data.recognition]] : []),
];
const lists = [
	['Mi papel', data.role],
	['Herramientas', data.tools],
	['Temas', data.tags],
] as const;
---

<Layout title={`${data.title} · David Ibáñez`} description={data.summary} image={socialImage?.src}>
	<SiteHeader />

	<main id="contenido">
		<article>
			<header class="shell pb-10 pt-10 md:pb-14 md:pt-16">
				<a
					href="/#proyectos"
					class="font-mono text-sm underline-offset-4 transition-colors hover:text-accent-text hover:underline"
				>
					<span aria-hidden="true">←</span> Todos los proyectos
				</a>
				<p class="mt-10 font-mono text-sm text-accent-text">
					{data.disciplines.map((discipline) => disciplineLabels[discipline]).join(' + ')}
				</p>
				<h1
					class="mt-5 max-w-[20ch] text-[clamp(2.25rem,5.6vw,5.25rem)] font-extrabold leading-[1.02] tracking-[-0.04em]"
				>
					{data.title}
				</h1>
				<p class="mt-8 max-w-3xl text-lg leading-relaxed text-muted md:text-xl">{data.summary}</p>
			</header>

			{
				data.cover && (
					<div class="shell">
						<Image
							src={data.cover.src}
							alt={data.cover.alt}
							widths={[800, 1200, 1440]}
							sizes="(min-width: 1440px) 1360px, 100vw"
							priority
							class="aspect-[24/13] w-full bg-line object-cover object-top"
						/>
					</div>
				)
			}

			{
				data.metrics.length > 0 && (
					<div class="shell mt-10 md:mt-14">
						<ul class="grid gap-8 border-y border-ink py-8 sm:grid-cols-2 lg:grid-cols-4">
							{data.metrics.map((metric) => (
								<li>
									<span class="block text-4xl font-extrabold tracking-tight md:text-5xl">{metric.value}</span>
									<span class="mt-2 block text-sm leading-snug text-muted">{metric.label}</span>
								</li>
							))}
						</ul>
					</div>
				)
			}

			<div class="shell grid gap-12 py-12 md:py-20 lg:grid-cols-12 lg:gap-16">
				<aside class="self-start lg:sticky lg:top-8 lg:col-span-4" aria-label="Ficha del proyecto">
					<dl class="space-y-5 text-sm leading-relaxed">
						{
							facts.map(([label, value]) => (
								<div>
									<dt class="font-mono text-xs text-muted">{label}</dt>
									<dd class="mt-1 font-medium">{value}</dd>
								</div>
							))
						}
						{
							lists.map(([label, items]) => (
								<div>
									<dt class="font-mono text-xs text-muted">{label}</dt>
									<dd class="mt-1">{items.join(' · ')}</dd>
								</div>
							))
						}
					</dl>
					{
						data.links.length > 0 && (
							<ul class="mt-8 space-y-2 border-t border-line pt-6 text-sm font-medium">
								{data.links.map((link) => (
									<li>
										<a
											href={link.url}
											class="inline-flex min-h-6 items-center gap-1 text-accent-text underline underline-offset-4 transition-colors hover:text-ink"
										>
											{link.label}
											<span aria-hidden="true">↗</span>
										</a>
									</li>
								))}
							</ul>
						)
					}
				</aside>

				<div class="case-prose lg:col-span-8">
					<Content />
				</div>
			</div>
		</article>

		{
			next.id !== project.id && (
				<nav aria-label="Siguiente proyecto" class="shell pb-16 md:pb-24">
					<a href={`/proyectos/${next.id}`} class="group block border-t border-ink pt-6">
						<span class="font-mono text-sm text-muted">Siguiente proyecto</span>
						<span class="mt-3 block max-w-[24ch] text-3xl font-extrabold leading-tight tracking-tight underline-offset-4 transition-colors group-hover:text-accent-text group-hover:underline md:text-5xl">
							{next.data.title} <span aria-hidden="true">→</span>
						</span>
					</a>
				</nav>
			)
		}
	</main>

	<SiteFooter />
</Layout>
