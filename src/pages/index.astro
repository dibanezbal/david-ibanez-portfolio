---
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
import { formatPeriod } from '../lib/format';
import { getPublishedProjects } from '../lib/projects';

const home = await getEntry('site', 'home');
if (!home) throw new Error('Falta src/content/site/home.md');
const { Content: About } = await render(home);
const { hero, skills, tools } = home.data;

const projects = await getPublishedProjects();
const jobs = (await getCollection('experience')).sort(
	(a, b) => b.data.startDate.getTime() - a.data.startDate.getTime(),
);
---

<Layout title={home.data.seo_title} description={home.data.description}>
	<SiteHeader />

	<main id="contenido">
		<section class="shell pt-10 md:pt-16">
			<div class="grid gap-10 border-b border-ink lg:grid-cols-12 lg:items-end lg:gap-8">
				<div class="lg:col-span-7 lg:pb-16">
					<p class="font-mono text-sm text-accent-text">{hero.eyebrow}</p>
					<h1
						class="mt-6 text-[clamp(2.75rem,5.7vw,5.75rem)] font-extrabold leading-[0.98] tracking-[-0.045em]"
					>
						{hero.headline} <span class="block text-accent-text">{hero.headline_accent}</span>
					</h1>
					<p class="mt-8 max-w-2xl text-lg leading-relaxed text-muted md:text-xl">{hero.intro}</p>
					<div class="mt-8 flex flex-wrap items-start gap-3">
						<a
							href={hero.cta_primary.url}
							class="border border-ink bg-ink px-6 py-3.5 font-medium text-paper transition-colors hover:border-accent-text hover:bg-accent-text"
						>
							{hero.cta_primary.label}
						</a>
						<a
							href={hero.cta_secondary.url}
							class="border border-ink px-6 py-3.5 font-medium transition-colors hover:bg-ink hover:text-paper"
						>
							{hero.cta_secondary.label}
						</a>
					</div>
				</div>
				<div class="lg:col-span-5">
					<!-- multiply funde el fondo de la foto con el papel; brightness lleva a blanco puro el fondo, que no lo es del todo. El recorte deja fuera las motas de la chaqueta -->
					<Image
						src={hero.portrait.src}
						alt={hero.portrait.alt}
						width={1200}
						widths={[480, 800, 1200]}
						sizes="(min-width: 1440px) 560px, (min-width: 1024px) 40vw, 100vw"
						priority
						class="aspect-[8/9] w-full object-cover object-top mix-blend-multiply brightness-[1.02]"
					/>
				</div>
			</div>
		</section>

		<section class="shell pb-16 pt-16 md:pb-24 md:pt-24">
			<div class="mb-12 grid gap-6 md:mb-16 md:grid-cols-12">
				<div class="md:col-span-6"><SectionHeading id="proyectos" title="Proyectos" /></div>
				<p class="text-lg leading-relaxed text-muted md:col-span-6">{home.data.projects_intro}</p>
			</div>
			{projects.map((project) => <ProjectCard {project} />)}
		</section>

		<section class="shell border-t border-line py-16 md:py-24" aria-labelledby="que-aporto">
			<SectionHeading id="que-aporto" title="Qué aporto" />
			<div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
				{
					skills.map((group) => (
						<div>
							<h3 class="border-t border-ink pt-4 font-mono text-sm font-medium">{group.title}</h3>
							<ul class="mt-4 space-y-2.5 text-[0.95rem] leading-relaxed text-muted">
								{group.items.map((item) => <li>{item}</li>)}
							</ul>
						</div>
					))
				}
			</div>
			<p class="mt-12 font-mono text-xs leading-relaxed text-muted">
				Herramientas: {tools.join(' · ')}
			</p>
		</section>

		<section class="shell border-t border-line py-16 md:py-24" aria-labelledby="experiencia">
			<SectionHeading id="experiencia" title="Experiencia" />
			<div class="mt-12 border-b border-ink">
				{
					jobs.map(({ data }, index) => (
						<details class="group border-t border-ink" open={index === 0}>
							<summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 transition-colors hover:text-accent-text [&::-webkit-details-marker]:hidden">
								<span class="grid flex-1 gap-1 md:grid-cols-12 md:gap-6">
									<span class="font-mono text-xs leading-6 text-muted md:col-span-3">
										{formatPeriod(data)}
									</span>
									<span class="text-lg font-bold leading-snug tracking-tight md:col-span-5">
										{data.role}
									</span>
									<span class="leading-snug text-muted md:col-span-4 md:leading-7">{data.company}</span>
								</span>
								<span
									aria-hidden="true"
									class="font-mono text-lg leading-6 transition-transform group-open:rotate-45"
								>
									+
								</span>
							</summary>
							<div class="grid gap-4 pb-8 md:grid-cols-12 md:gap-6">
								<div class="md:col-span-8 md:col-start-4">
									<p class="font-mono text-xs leading-relaxed text-muted">
										{data.location}
										{data.via && ` · ${data.via}`}
									</p>
									<ul class="mt-4 list-disc space-y-2.5 pl-5 text-[0.95rem] leading-relaxed text-muted marker:text-accent-text">
										{data.highlights.map((highlight) => <li>{highlight}</li>)}
									</ul>
									{
										data.stack.length > 0 && (
											<p class="mt-5 font-mono text-xs leading-relaxed text-muted">
												{data.stack.join(' · ')}
											</p>
										)
									}
								</div>
							</div>
						</details>
					))
				}
			</div>
		</section>

		<section class="shell grid gap-8 py-16 md:grid-cols-12 md:py-24" aria-labelledby="sobre-mi">
			<div class="md:col-span-5"><SectionHeading id="sobre-mi" title="Sobre mí" /></div>
			<div
				class="max-w-prose text-lg leading-relaxed text-muted md:col-span-7 [&_em]:italic [&_p+p]:mt-5 [&_strong]:font-bold [&_strong]:text-ink"
			>
				<About />
			</div>
		</section>
	</main>

	<SiteFooter />
</Layout>
